---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import heroImage from "../../assets/images/training-fleet.avif";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Twelve weeks: four on the ground, four in the simulator, and then you fly."
  heroImage={heroImage}
  heroImageAlt="Four F-16s in loose formation over a coastline, seen from above and behind, farmland and forest inland of a long sand beach"
  {...siteConfig}
>
  <p>
    The school owns four aircraft. You will fly one of them, once, alone, in
    week 10 — and again in week 12 for the check ride. Everything else on this
    page is preparation for those two sorties.
  </p>
  <p>
    Weeks 1 to 4 are on the ground and end with an examination you have to pass
    to continue. Weeks 5 to 8 are in the simulator and end with the progression
    check, which is the gate: no signature, no aircraft. Week 9 is the last
    period before you fly, and it has almost no aerodynamics in it.
  </p>
  <SessionsGrid />
</ContentLayout>
